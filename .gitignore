.env
__pycache__/
*.pyc
.ipynb_checkpoints/

# train.jsonl é artefato de build (build_dataset.py), regenerado no Colab a partir de dataset.jsonl
data/clean/train.jsonl

# data/raw/: ignora os planos de task (regeneráveis por seed) e versiona os exemplos escritos à mão
data/raw/tasks_*.jsonl
!data/raw/gen/
!data/raw/gen/**
!data/raw/pilot.jsonl
!data/raw/GEN_PROGRESS.md

# outputs/: versiona métricas e relatórios (leves), ignora adapters e modelos merged (pesados)
outputs/adapter_*/
outputs/merged_*/
outputs_*/

# eidos/: workdirs do harness (com node_modules) e transcripts de eval sao locais;
# metrics.json dos resultados e versionado junto com a analise, manualmente
eidos/.work/
eidos/.work_verify/
eidos/results/transcripts/
